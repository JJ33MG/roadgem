// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String
  name                String
  createdAt           DateTime  @default(now())
  subscriptionTier    String    @default("free")
  subscriptionExpires DateTime?
  /// Personal invite code (made on first use).
  inviteCode          String?   @unique
  invitedById         String?
  /// The Stripe subscription of a paying member (bonus days are kept apart from its period).
  stripeSubscriptionId String?
  /// Plus days earned with invites, counted after the paid period.
  plusBonusDays       Int       @default(0)
  /// The Routify team account: its posts are labelled as the team.
  isTeam              Boolean   @default(false)

  trips         Trip[]
  communityGems CommunityGem[]
  foundGems     Gem[]          @relation("FoundGems")
  posts         Post[]
  likes         Like[]
}

model Trip {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  startLocation String
  destination   String
  startDate     String
  endDate       String
  days          Int
  budget        Float
  travelStyle   String
  priorities    String
  totalCost     Float
  totalDistance Float
  stops         String
  highlights    String
  tips          String
  weather       String
  hiddenGems    String?
  fromTemplate  String?
  /// Routify planner choices as JSON: { kmPerDay, gemsPerDay, gemsEnabled, stayTypes, filters }.
  planner       String   @default("{}")
  createdAt     DateTime @default(now())

  itineraryDays TripDay[]
  bookings      Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId    String?
  type      String
  bookingId String
  cost      Float    @default(0)
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model TripDay {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  day    Int

  activities TripActivity[]
}

model TripActivity {
  id            String  @id @default(cuid())
  tripDayId     String
  tripDay       TripDay @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  slot          String
  time          String
  activity      String
  location      String
  description   String
  estimatedCost Float
  notes         String
}

model AgentMessage {
  id          String   @id @default(cuid())
  fromAgent   String
  toAgent     String
  type        String
  payload     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([toAgent, read])
}

model DestinationGem {
  id          String   @id @default(cuid())
  destination String
  name        String
  description String
  address     String
  latitude    Float?
  longitude   Float?
  category    String
  whyHidden   String
  photoUrl    String?
  createdAt   DateTime @default(now())

  @@index([destination])
}

model CommunityGem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  category    String
  location    String
  description String
  status      String   @default("pending") // pending | approved | rejected
  aiScore     Int      @default(0)
  aiFeedback  String   @default("")
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model TripTemplate {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  emoji         String   @default("🗺️")
  startLocation String
  destination   String
  days          Int
  budget        Float
  travelStyle   String
  highlights    String
  stops         String
  itinerary     String
  tips          String
  totalCost     Float
  totalDistance Float    @default(0)
  priceEur      Float    @default(4.99)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([slug])
  @@index([featured])
}

model TemplatePurchase {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  stripeId   String?
  createdAt  DateTime @default(now())

  @@unique([userId, templateId])
  @@index([userId])
}

model DestinationQueue {
  id             String    @id @default(cuid())
  destination    String    @unique
  country        String
  gemDepth       Int       @default(0)   // 0=untouched, 1=6gems, 2=12gems, 3=20+gems
  seoGenerated   Boolean   @default(false)
  priority       Int       @default(0)   // higher = process first
  source         String    @default("seed") // seed | auto-discovery | trending | user
  addedAt        DateTime  @default(now())
  lastResearched DateTime?

  @@index([gemDepth, priority])
}

model DestinationSeo {
  id                    String   @id @default(cuid())
  destination           String   @unique
  slug                  String   @unique
  title                 String
  metaDescription       String
  h1                    String
  intro                 String
  topKeywords           String
  faq                   String
  internalLinkSuggestions String
  updatedAt             DateTime @updatedAt

  @@index([slug])
}

model AgentRun {
  id          String   @id @default(cuid())
  agentName   String
  status      String   @default("running")
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  result      String?
  error       String?
  logs        AgentLog[]
}

model AgentLog {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  level     String   @default("info")
  message   String
  data      String?
  createdAt DateTime @default(now())
}

/// A click on a booking or rental link (affiliate partner), for the stats the AI Agency Brain reads.
model AffiliateClick {
  id        String   @id @default(cuid())
  partner   String
  tripId    String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Community game: a gem people can visit (an official Google gem, or a traveller's suggestion).
model Gem {
  id          String    @id @default(cuid())
  placeId     String?   @unique
  name        String
  lat         Float
  lng         Float
  address     String    @default("")
  category    String    @default("other")
  description String    @default("")
  status      String    @default("official") // official | suggested | rejected
  finderId    String?
  finder      User?     @relation("FoundGems", fields: [finderId], references: [id], onDelete: SetNull)
  challenge   String    @default("")
  createdAt   DateTime  @default(now())
  officialAt  DateTime?
  posts       Post[]

  @@index([status])
  @@index([finderId])
}

// A photo taken at a gem. Public only after moderation.
model Post {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gemId      String
  gem        Gem       @relation(fields: [gemId], references: [id], onDelete: Cascade)
  caption    String    @default("")
  photo      Bytes
  photoType  String
  distanceM  Int
  challenge  Boolean   @default(false)
  monthly    Boolean   @default(false) // an entry for the monthly challenge (Plus)
  status     String    @default("pending") // pending | public | rejected
  aiNote     String    @default("")
  points     Int       @default(0)
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  likes      Like[]

  @@index([status, createdAt])
  @@index([gemId])
  @@index([userId])
}

model Like {
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

// The gem library: real Google places along Europe's roads that passed the checks
// (rating, number of reviews, kind of place). Every trip and the seeding job add to it.
model PlaceGem {
  id        String   @id @default(cuid())
  placeId   String   @unique
  name      String
  lat       Float
  lng       Float
  address   String   @default("")
  category  String   @default("other")
  rating    Float
  reviews   Int
  photoRef  String?
  types     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lat, lng])
}

// A map cell (about 11 km) already searched on Google, so it is not searched again for a while.
model GemSearch {
  cell   String   @id
  source String   @default("trip") // trip | seed
  found  Int      @default(0)
  at     DateTime @default(now())

  @@index([source])
}

// A stamp in a traveller's trip passport: checked in at one of the trip's gems, on the spot.
model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  tripId    String
  placeId   String
  name      String
  lat       Float
  lng       Float
  distanceM Int
  points    Int
  createdAt DateTime @default(now())

  @@unique([userId, tripId, placeId])
  @@index([userId])
}

// A friend who signed up through someone's invite link (both get Plus time).
model Invite {
  id        String   @id @default(cuid())
  inviterId String
  inviteeId String   @unique
  rewarded  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([inviterId, createdAt])
}

// Tester feedback from the button on every page (27 Nov); also sent to Jarne on Telegram through the Brain.
model Feedback {
  id        String   @id @default(cuid())
  type      String   @default("other") // bug | idea | other
  message   String
  page      String   @default("")
  email     String   @default("")
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
